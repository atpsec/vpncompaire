# Marka & site temel ayarları
NEXT_PUBLIC_SITE_NAME="VPN Advisor"
NEXT_PUBLIC_SITE_BRAND="VPN Advisor"
NEXT_PUBLIC_SITE_URL=https://vpnadvisor.net

# Google Analytics 4 (consent banner ile birlikte çalışır) — production'da aç
NEXT_PUBLIC_GA_ID=

# Bing Webmaster Tools site verification token (optional until Bing setup)
BING_SITE_VERIFICATION=

# Google AdSense publisher ID (ca-pub-XXXXXXXXXXXXXXXX) — set edilince Auto Ads
# script'i yüklenir ve /ads.txt dolu döner. Boşsa hiçbir reklam basılmaz.
NEXT_PUBLIC_ADSENSE_CLIENT_ID=

# Upstash-compatible Redis REST (dağıtık rate limiting ve kalıcı blog
# okunma sayıları için). Hostinger ortam değişkenleri olarak tanımlanır.
# Redis yoksa uygulama, public/ dışında atomik bir JSON dosyası kullanır.
# Hostinger'da bu yolu deployment kökünün dışındaki kalıcı kullanıcı dizinine
# taşı (ör. /home/YOUR_HOSTINGER_USER/.runtime/blog-views.json); göreli
# .runtime yolu yeni dağıtımlarda sıfırlanabilir.
KV_REST_API_URL=
KV_REST_API_TOKEN=
BLOG_VIEW_STORE_PATH=.runtime/blog-views.json
PHONE_AUTH_STORE_PATH=.runtime/phone-auth.json

# Affiliate URL'leri (hepsi opsiyonel; set edilmezse public URL'e UTM ile yönlenir)
# AFFILIATE_NORDVPN_URL=
# AFFILIATE_SURFSHARK_URL=
# ... (bkz. src/env.ts)
