# Hostinger hPanel → Node.js Apps → Environment variables
# Production values for vpnadvisor.net (copy each line into hPanel)

NEXT_PUBLIC_SITE_URL=https://vpnadvisor.net
NEXT_PUBLIC_SITE_NAME=VPN Advisor
NEXT_PUBLIC_SITE_BRAND=VPN Advisor
NEXT_PUBLIC_GA_ID=G-QLM2QBB9S4
BING_SITE_VERIFICATION=
NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-8715861903175610
# Preferred for shared, redeploy-safe readership counts. Create an
# Upstash-compatible Redis database and copy these two values from its REST
# credentials. If KV is unavailable, use a path outside the deployment root
# so Hostinger redeploys do not replace the local readership file.
KV_REST_API_URL=
KV_REST_API_TOKEN=
BLOG_VIEW_STORE_PATH=/home/YOUR_HOSTINGER_USER/.runtime/blog-views.json
PHONE_AUTH_STORE_PATH=.runtime/phone-auth.json
